# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# npm cache used by the sandbox
/.npm/
coverage/
test-results/

# MikroORM migration snapshots for throwaway integration-test databases
# (the INTEGRATION_DATABASE_ADMIN_URL fallback names each run's database
# uniquely, which would otherwise litter this folder with one snapshot per run)
packages/core/src/migrations/.snapshot-*_it_*.json

# agent pipeline (om-*): generated QA run state, never source
.ai/qa/artifacts_*/
.ai/qa/test-env.json
.ai/qa/test-env.env
