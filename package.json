{
  "name": "plant-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @plant-ai/app --",
    "build": "npm run build -w @plant-ai/app",
    "start": "npm run start -w @plant-ai/app --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @plant-ai/core",
    "db:migrate:create": "npm run db:migrate:create -w @plant-ai/core --",
    "db:migrate:down": "npm run db:migrate:down -w @plant-ai/core",
    "ui:add": "npm run ui:add -w @plant-ai/ui --"
  },
  "type": "module"
}
