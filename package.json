{
  "name": "plant-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @plant-ai/app --",
    "build": "npm run build -w @plant-ai/app",
    "start": "npm run start -w @plant-ai/app --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tests",
    "db:migrate": "npm run db:migrate -w @plant-ai/core",
    "db:migrate:create": "npm run db:migrate:create -w @plant-ai/core --",
    "db:migrate:down": "npm run db:migrate:down -w @plant-ai/core",
    "ui:add": "npm run ui:add -w @plant-ai/ui --",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.4",
    "agent-browser": "^0.39.1",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "awilix": {
      "fast-glob": "file:../../tools/fast-glob-disabled"
    }
  },
  "type": "module"
}
