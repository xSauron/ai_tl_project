# Copy to `.env` (repo root): loaded by both Next.js (@plantai/app) and the MikroORM CLI (@plantai/db).
# Variables already set in the environment win. An empty value counts as unset (its default applies).

# --- Database (@plantai/db, packages/db/src/env.ts) ---
# PostgreSQL connection string. Required at runtime (not at build time).
DATABASE_URL=postgresql://plant_ai:plant_ai@localhost:5432/plant_ai
# Connection pool size per Node.js process (integers, DB_POOL_MIN ≤ DB_POOL_MAX, DB_POOL_MAX ≥ 1).
DB_POOL_MIN=0
DB_POOL_MAX=10
# Log SQL queries: true | false
DB_DEBUG=false

# --- App (@plantai/core, packages/core/src/config/env.ts) ---
# Session signing secret, at least 32 bytes. Required at request time (not at build time);
# authenticated requests fail closed without it. `npm run setup` generates one, or run:
#   openssl rand -base64 48
JWT_SECRET=
# pino log level: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Rate limits key login/register by client IP only when the deploy's proxy OVERWRITES this
# header with the real client IP (e.g. x-real-ip). Leave empty otherwise: a header the client
# can set (raw x-forwarded-for) would let anyone dodge the limit. Default: unset (e-mail key only).
TRUSTED_PROXY_IP_HEADER=
# NODE_ENV (production | development | test) is set by Next.js / Vitest; never set it yourself.
